{
  "name": "reef-ops-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "migrate:deploy": "prisma migrate deploy",
    "species-library:import": "prisma generate && tsx scripts/import-species-library.ts",
    "species-library:verify-matcher": "tsx scripts/verify-species-matcher.ts",
    "species-library:verify-webhook": "tsx scripts/verify-species-webhook.ts",
    "species-library:verify-validation": "tsx scripts/verify-species-validation.ts",
    "collection-rotation:scheduled": "tsx scripts/run-collection-rotations.ts",
    "marketing:scheduled": "tsx scripts/run-marketing.ts",
    "scheduled:all": "tsx scripts/run-scheduled-jobs.ts",
    "marketing:test": "node scripts/verify-marketing.cjs test",
    "build:check": "node scripts/verify-marketing.cjs build",
    "marketing:browser:test": "node scripts/marketing.browser.test.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "he": "^1.2.0",
    "next": "16.3.4",
    "openai": "^6.45.0",
    "pg": "^8.16.3",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@electric-sql/pglite-socket": "^0.1.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/he": "^1.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
