generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model FeedbackItem {
  id String @id @default(cuid())

  source            String
  sourceUrl         String?
  customerReference String?
  feedbackText      String
  staffNote         String?

  aiSentiment           String
  aiIssueTypes          String
  aiSeverity            String
  aiValidityEstimate    String
  aiSuggestedStatus     String
  aiConfidence          Float
  aiSummary             String
  aiSuggestedNextAction String
  aiSuggestedResponse   String?
  aiMissingInformation  String

  status String @default("New")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScanResult {
  id String @id @default(cuid())

  source      String  @default("Brave Search")
  query       String
  title       String
  url         String  @unique
  domain      String?
  description String?
  age         String?
  sourceName  String?
  sourceUrl   String?

  status String @default("New")

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventorySnapshot {
  id String @id @default(cuid())

  shop String

  productId       String?
  variantId       String?
  inventoryItemId String
  locationId      String

  sku          String?
  productTitle String?
  variantTitle String?
  locationName String?

  available Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, inventoryItemId, locationId])
  @@index([shop])
  @@index([inventoryItemId])
  @@index([variantId])
  @@index([locationId])
}

model RawInventoryUpdate {
  id String @id @default(cuid())

  shop String

  inventoryItemId String
  locationId      String

  available  Int
  rawPayload String?

  receivedAt DateTime @default(now())

  @@index([shop])
  @@index([inventoryItemId])
  @@index([locationId])
  @@index([receivedAt])
}

model InventoryMovementWindow {
  id String @id @default(cuid())

  shop String

  productId       String?
  variantId       String?
  inventoryItemId String
  locationId      String

  sku          String?
  productTitle String?
  variantTitle String?
  locationName String?

  startingAvailable Int
  latestAvailable   Int
  netDelta          Int

  firstChangeAt DateTime
  lastChangeAt  DateTime
  finalizeAfter DateTime

  status String @default("Pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
  @@index([inventoryItemId])
  @@index([variantId])
  @@index([locationId])
  @@index([status])
  @@index([finalizeAfter])
}

model InventoryEvent {
  id String @id @default(cuid())

  shop String

  productId       String?
  variantId       String?
  inventoryItemId String
  locationId      String

  sku          String?
  productTitle String?
  variantTitle String?
  locationName String?

  startingAvailable Int
  endingAvailable   Int
  netDelta          Int

  matchedOrderQuantity  Int @default(0)
  unknownChangeQuantity Int @default(0)

  eventType String

  matchedOrderIds   String?
  matchedOrderNames String?

  reviewStatus String @default("Unreviewed")

  ownerNote String?

  detectedAt DateTime  @default(now())
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
  @@index([inventoryItemId])
  @@index([variantId])
  @@index([locationId])
  @@index([eventType])
  @@index([reviewStatus])
  @@index([detectedAt])
}

model OrderInventoryClaim {
  id String @id @default(cuid())

  shop String

  orderId   String
  orderName String?

  productId       String?
  variantId       String?
  inventoryItemId String?

  sku          String?
  productTitle String?
  variantTitle String?

  quantitySold    Int
  claimedQuantity Int @default(0)

  orderCreatedAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shop])
  @@index([orderId])
  @@index([variantId])
  @@index([inventoryItemId])
  @@index([orderCreatedAt])
}

model ProductInventoryState {
  id String @id @default(cuid())

  shop String

  productId     String
  productHandle String?
  productTitle  String?

  totalAvailable Int
  initializedAt  DateTime @default(now())
  checkedAt      DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, productId])
  @@index([shop])
  @@index([productId])
  @@index([totalAvailable])
}

model ProductRestockWaitlist {
  id String @id @default(cuid())

  shop String

  productId     String
  productHandle String?
  productTitle  String?

  email String

  status String @default("Waiting")

  subscribedAt     DateTime  @default(now())
  notifiedAt       DateTime?
  unsubscribedAt   DateTime?
  unsubscribeToken String    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
  @@index([productId])
  @@index([email])
  @@index([status])
  @@index([subscribedAt])
}

// -----------------------------------------------------------------------------
// REORDER PLANNER
// -----------------------------------------------------------------------------

model SupplierItem {
  id String @id @default(cuid())

  supplierCode           String @unique
  supplierName           String
  normalizedSupplierName String

  latestAvailableQty Int?
  lastSeenAt         DateTime?

  reorderMapping ReorderMapping?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierName])
  @@index([normalizedSupplierName])
  @@index([lastSeenAt])
}

model ReorderMapping {
  id String @id @default(cuid())

  supplierItemId String?       @unique
  supplierItem   SupplierItem? @relation(fields: [supplierItemId], references: [id], onDelete: SetNull)

  supplierCode String? @unique

  supplierName           String
  normalizedSupplierName String @unique

  targetStockQuantity Int
  isActive            Boolean @default(true)

  variants ReorderVariantMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierCode])
  @@index([supplierName])
  @@index([isActive])
}

model ReorderVariantMapping {
  id String @id @default(cuid())

  mappingId String
  mapping   ReorderMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  shop String @default("corals-anonymous.myshopify.com")

  productId       String?
  variantId       String
  inventoryItemId String?

  productTitle String
  variantTitle String?
  sku          String?

  unitsPerVariant Int @default(1)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mappingId, shop, variantId])
  @@index([mappingId])
  @@index([variantId])
  @@index([inventoryItemId])
  @@index([isActive])
}

// -----------------------------------------------------------------------------
// COLLECTION ROTATION
// -----------------------------------------------------------------------------

model CollectionRotation {
  id String @id @default(cuid())

  shop String

  shopifyCollectionId String
  collectionTitle     String
  collectionHandle    String?

  isEnabled Boolean @default(false)
  isStarred Boolean @default(false)

  controlledTopCount    Int @default(0)
  controlledBottomCount Int @default(0)

  strategy              String @default("BALANCED")
  performanceWeight     Int    @default(45)
  exposureWeight        Int    @default(30)
  freshnessWeight       Int    @default(15)
  explorationWeight     Int    @default(10)
  analyticsLookbackDays Int    @default(30)

  lastShuffledAt DateTime?
  lastStatus     String?
  lastError      String?

  runs               CollectionRotationRun[]
  controlledProducts CollectionControlledProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, shopifyCollectionId])
  @@index([shop])
  @@index([shopifyCollectionId])
  @@index([isEnabled])
  @@index([isStarred])
  @@index([controlledTopCount])
  @@index([controlledBottomCount])
  @@index([lastShuffledAt])
}

// A shop-wide, named set of the four rotation weights (performance/exposure/
// freshness/exploration) - lets someone save a custom orientation once (e.g.
// "Aggressive clearance") and re-apply it later, either to a single
// collection's Strategy panel or across many collections at once via bulk
// assignment, without re-typing the same four numbers every time. Not tied
// to any one collection - @@unique([shop, name]) means saving again under an
// existing name just overwrites that preset's weights.
model RotationWeightPreset {
  id String @id @default(cuid())

  shop String
  name String

  performanceWeight Int
  exposureWeight    Int
  freshnessWeight   Int
  explorationWeight Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, name])
  @@index([shop])
}

model CollectionRotationRun {
  id String @id @default(cuid())

  rotationId String
  rotation   CollectionRotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)

  shop                String
  shopifyCollectionId String
  collectionTitle     String

  triggerType String @default("Manual")
  status      String @default("Pending")

  productCount Int @default(0)

  previousProductIds Json
  shuffledProductIds Json?

  shopifyJobIds   Json?
  scoringSnapshot Json?

  errorMessage String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  undoneAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rotationId])
  @@index([shop])
  @@index([shopifyCollectionId])
  @@index([triggerType])
  @@index([status])
  @@index([startedAt])
  // Matches collection-rotation-plan.ts's exposure-history query exactly
  // (WHERE rotationId/status/undoneAt, ORDER BY completedAt DESC) - added
  // when that query stopped capping at the 42 most recent runs, so it
  // still resolves via an index scan (already in the right sort order)
  // instead of a full table scan as a collection's run history grows.
  @@index([rotationId, status, undoneAt, completedAt])
}

model CollectionProductAnalytics {
  id String @id @default(cuid())

  shop            String
  productId       String
  productTitle    String?
  source          String
  lookbackDays    Int
  // 0 = the current lookback window ending now. 1 = the immediately
  // preceding window of the same length (e.g. days 31-60 ago, when
  // lookbackDays is 30). The prior window exists so Performance scoring can
  // compute sales momentum (recent vs. prior) without needing GA4 or any
  // other page-view tracking.
  periodOffset    Int      @default(0)
  productViews    Int      @default(0)
  listViews       Int      @default(0)
  listClicks      Int      @default(0)
  addsToCart      Int      @default(0)
  purchases       Int      @default(0)
  unitsSold       Int      @default(0)
  revenue         Float    @default(0)
  windowStartedAt DateTime
  windowEndedAt   DateTime
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, productId, source, lookbackDays, periodOffset])
  @@index([shop])
  @@index([productId])
  @@index([source])
  @@index([syncedAt])
}

model CollectionAnalyticsSync {
  id           String    @id @default(cuid())
  shop         String
  source       String
  status       String    @default("Running")
  lookbackDays Int
  rowCount     Int       @default(0)
  matchedCount Int       @default(0)
  errorMessage String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shop])
  @@index([source])
  @@index([status])
  @@index([startedAt])
}

model CollectionControlledProduct {
  id String @id @default(cuid())

  rotationId String
  rotation   CollectionRotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)

  shopifyProductId String
  productTitle     String
  productHandle    String?
  imageUrl         String?

  // "TOP" pins a product counting down from the front of the collection
  // (position 1 = first slot); "BOTTOM" pins counting up from the end
  // (position 1 = last slot, position 2 = second-to-last, etc.) - see
  // applyControlledPositions() in collection-rotation-plan.ts for how each
  // zone's position resolves to an actual index.
  zone String @default("TOP")

  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A position number is only unique within its own zone - "TOP position 1"
  // and "BOTTOM position 1" are different slots (opposite ends of the
  // collection), so the zone must be part of the composite key.
  @@unique([rotationId, zone, position])
  // A product can only hold ONE controlled assignment total, whether top or
  // bottom - this stays a plain (rotationId, shopifyProductId) key so the
  // same product can't be pinned to both ends at once.
  @@unique([rotationId, shopifyProductId])
  @@index([rotationId])
  @@index([shopifyProductId])
  @@index([zone])
}

model CollectionRotationScheduleRun {
  id String @id @default(cuid())

  scheduledFor DateTime @unique

  status String @default("Running")

  enabledCount   Int @default(0)
  completedCount Int @default(0)
  failedCount    Int @default(0)

  results Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduledFor])
  @@index([status])
  @@index([startedAt])
}
